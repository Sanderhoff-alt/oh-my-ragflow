# Model Platform Gateway Environment Variables Example
POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=litellm_secure_password_replace_in_prod

# Master key used by Go backend to manage virtual keys (keep strictly internal)
LITELLM_MASTER_KEY=sk-platform-master-key-secret-replace-in-prod
LITELLM_SALT_KEY=platform-salt-key-secret-replace-in-prod

# Upstream model provider root credentials (injected only into gateway container)
PLATFORM_UPSTREAM_OPENAI_KEY=sk-upstream-openai-key-here
PLATFORM_UPSTREAM_OPENAI_BASE=https://api.openai.com/v1

# Optional override for custom or pre-encoded connection string (e.g., if password contains URL-special characters)
# DATABASE_URL=postgresql://litellm:litellm_secure_password_replace_in_prod@litellm-postgres:5432/litellm
